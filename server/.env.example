# Server Configuration
PORT=4000
MONGODB_URL=mongodb://127.0.0.1:27017/studynotion

# JWT Secret Configuration
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer / SMTP Email Service Configuration
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
# Optional: SMTP port (default 587). Use 2525 for Brevo on Render's free plan
MAIL_PORT=587
# Optional: sender address, needed when MAIL_USER is not an email (e.g. Brevo SMTP login)
MAIL_FROM=your_email@gmail.com

# Cloudinary Media Storage Credentials
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FOLDER_NAME=StudyNotion

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_key_secret

# Gemini API key for the AI Course Advisor ("Is this course right for me?")
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: Gemini model to use (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Frontend URL used in password-reset emails
FRONTEND_URL=http://localhost:3000

# Set to true to create a demo instructor (known password) and demo courses. Local development only!
SEED_DEMO_DATA=false
